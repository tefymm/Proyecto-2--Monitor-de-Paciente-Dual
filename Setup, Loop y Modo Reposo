#include <Servo.h> 
//Importamos la libreria para controlar el Servo

Servo miServo; //Nombre para el Servo 

//============================================================
// Pines
//============================================================


//Servo
int servoPin = 7;

//Led RGB
int R = 2;
int G = 4;
int B = 3;

//Otros
int botonModo = 5;
int buzzer = 6;
int pot = A0;
int botonAlarma = A4;

// Segmentos display
int a = 10;
int b = 11;
int c = 12;
int d = A5;
int e = 13;
int f = 8;
int g = 9;

int alarma = 0;
int modo = 0; //Inicia en reposo (variable modo)
int estadoSalida = 0; //Variable Antirebote

void setup() { //Ocurre solo una vez -> cuando inicia
 
  Serial.begin(9600);

  miServo.attach(servoPin); 
  

  pinMode(R, OUTPUT); //Configuración led RGB como salida
  pinMode(G, OUTPUT);
  pinMode(B, OUTPUT);

  pinMode(botonModo, INPUT);// Botón 1
  pinMode(botonAlarma, INPUT);//Botón 2
  pinMode(buzzer, OUTPUT);

  pinMode(a, OUTPUT); // Configuración Display como salida
  pinMode(b, OUTPUT);
  pinMode(c, OUTPUT);
  pinMode(d, OUTPUT);
  pinMode(e, OUTPUT);
  pinMode(f, OUTPUT);
  pinMode(g, OUTPUT);
}

void loop() { //Repite infinitamente

  int estado = digitalRead(botonModo); //Revisa el estado del botón

  delay(15);

  // Detecta cuando se presiona
  if (estado == HIGH) {
    estadoSalida = 1;
  }

  // Cambia modo SOLO cuando se suelta - Antirebote
  if (estadoSalida == 1 && estado == LOW) {

    modo++;//Le suma al modo

    if (modo > 2) { //No pasa de 2
      modo = 0;
    }

    estadoSalida = 0; //Reinicia
  }

  //==========================================================
  // MODOS
  //==========================================================

  if (modo == 0) {
    modoReposo();
  }
  
  else if (modo == 1) {
    modoFrecuenciaC();
  }

  else if (modo == 2) {
    modoTempC();
  }

}

// ---------------- FUNCIONES 0 , 1 Y 2 ----------------


// MODO 0
void modoReposo() {
  // LED RGB apagado
  digitalWrite(R, LOW);
  digitalWrite(G, LOW);
  digitalWrite(B, LOW);

  // Buzzer apagado
  digitalWrite(buzzer, LOW);

  // Servo en 0 grados
  miServo.write(0); 

  // Display muestra 0
  mostrarCero();
}


// DISPLAY NUMERO 0

void mostrarCero() {
  digitalWrite(a, HIGH); //luces en HIGH para formar el 0
  digitalWrite(b, HIGH);
  digitalWrite(c, HIGH);
  digitalWrite(d, HIGH);
  digitalWrite(e, HIGH);
  digitalWrite(f, HIGH);
  digitalWrite(g, LOW);
}

