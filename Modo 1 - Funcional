//============================================================

void setRGB(int r, int g_, int b_) { 
  digitalWrite(R, r);
  digitalWrite(G, g_);
  digitalWrite(B, b_);
}

//============================================================
// DISPLAY NUMERO 1
//============================================================

void mostrarUno() {
  digitalWrite(a, LOW);
  digitalWrite(b, HIGH);
  digitalWrite(c, HIGH);
  digitalWrite(d, LOW);
  digitalWrite(e, LOW);
  digitalWrite(f, LOW);
  digitalWrite(g, LOW);
}
  
